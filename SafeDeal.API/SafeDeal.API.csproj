<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Les commentaires XML des controleurs alimentent directement le document
         OpenAPI : la documentation vit a cote du code qu'elle decrit. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- CS1591 : chaque membre public non commente deviendrait un avertissement.
         CS1573 : documenter le jeton d'annulation de chaque action serait du
         bruit — seuls les parametres que l'appelant renseigne sont decrits. -->
    <NoWarn>$(NoWarn);CS1591;CS1573</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="9.0.7" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.10" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="9.0.7" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="9.0.7">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.OpenApi" Version="2.0.1" />
    <PackageReference Include="Scalar.AspNetCore" Version="2.5.17" />
    <PackageReference Include="Stripe.net" Version="47.3.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SafeDeal.Application\SafeDeal.Application.csproj" />
    <ProjectReference Include="..\SafeDeal.Infrastructure\SafeDeal.Infrastructure.csproj" />
  </ItemGroup>

</Project>
